# VADO Control (yönetim paneli) ayarları. Bu dosyayı .env.local adıyla kopyalayıp doldurun.

# Panel sunucusunun API'ye ulaştığı adres (tarayıcıdan değil, sunucudan sunucuya).
VADO_API_INTERNAL_URL=http://localhost:4000

# API'deki VADO_ADMIN_API_KEY ile aynı değer. Yalnızca panel sunucusunda durur, tarayıcıya gitmez.
# Geliştirmede boş bırakılırsa API'nin geliştirme anahtarı kullanılır.
VADO_ADMIN_API_KEY=

# Panele her yönetici kendi hesabıyla ve iki adımlı doğrulamayla girer; panelin ortak kullanıcı
# adı ve şifresi (VADO_PORTAL_USER, VADO_PORTAL_PASSWORD) 2.4'te kaldırıldı. Geliştirmede örnek
# hesaplar `npm run db:seed` ile açılır (README.md).
