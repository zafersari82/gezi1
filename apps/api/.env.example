# VADO API ayarları. Geliştirmede hiçbiri zorunlu değildir; varsayılanlar yerel kurulumla çalışır.
# Değiştirmek istediklerinizi bu dosyadan .env adlı bir dosyaya kopyalayın.

# --- Sunucu -------------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# HOST=0.0.0.0
# LOG_LEVEL=info

# PostgreSQL bağlantısı.
# DATABASE_URL=postgres://vado:vado@localhost:5432/vado

# Birden çok API süreci çalışacaksa gerçek zamanlı bildirimler Redis üzerinden paylaşılır.
# Tek süreçte gerekmez.
# REDIS_URL=redis://localhost:6379

# API'nin dışarıdan erişilen adresi; fotoğraf bağlantıları bununla kurulur.
# Telefonla denerken `npm run lan` bunu bilgisayarın ağ adresine çevirir.
# VADO_PUBLIC_URL=http://localhost:4000

# Tarayıcıdan API'ye istek gönderebilecek kaynaklar (web önizlemesi, panel, mini uygulamalar).
# VADO_CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173

# API bir ters vekilin (Nginx, yük dengeleyici) arkasındaysa true yapın; istemci IP adresi
# X-Forwarded-For başlığından okunur. Doğrudan internete açık sunucuda false kalmalıdır.
# VADO_TRUST_PROXY=false

# Bir IP adresinin dakikada gönderebileceği istek sayısı. Mobil operatörlerde çok sayıda kullanıcı
# aynı IP adresini paylaşır; kullanıcı sayısı arttıkça yükseltin.
# VADO_RATE_LIMIT_PER_MINUTE=600

# --- Güvenlik -----------------------------------------------------------------
# İmza anahtarları: doğrulama kodu, QR kodu ve mini uygulama kimliği için üç bağımsız aile.
# Geliştirmede tanımlamak gerekmez. Canlı ortamda üçü de zorunludur:  npm run keys -- generate
# Halka biçimi: kimlik:anahtar[,kimlik:anahtar:YYYY-AA-GG]; ilk anahtar imzalar, diğerleri yalnızca
# eski imzaları doğrular. Geçiş ve anahtar değiştirme adımları: docs/ANAHTARLAR.md
# VADO_OTP_KEYS=
# VADO_QR_KEYS=
# VADO_OPENID_KEY=

# 2.1 ve öncesinin tek ana anahtarı. Canlı ortamda artık kullanılmaz: yükseltirken yeni anahtarlar
# ondan `npm run keys -- migrate` ile üretilir, geçişten sonra kaldırılır. Geliştirmede tanımlıysa,
# yukarıda tanımlanmayan anahtarlar ondan türetilir.
# VADO_APP_SECRET=

# Yönetim panelinin API'ye erişirken kullandığı anahtar. Canlı ortamda en az 32 karakter.
# VADO_ADMIN_API_KEY=

# Kullanılmayan cihazın oturumunun kapanacağı süre (gün; kullanılan oturum kendiliğinden uzar) ve
# kişisel QR kodun geçerlilik süresi (saniye).
# VADO_SESSION_DAYS=30
# VADO_USER_QR_TTL_SECONDS=600

# --- Demo modu ----------------------------------------------------------------
# Açıkken SMS gönderilmez ve doğrulama kodu her zaman 000000 olur. Canlı ortamda false olmalıdır.
# VADO_DEMO_MODE=true

# --- SMS ----------------------------------------------------------------------
# log: kod yalnızca sunucu günlüğüne yazılır (geliştirme).
# webhook: kod, SMS sağlayıcınıza bağlanan kendi uç noktanıza gönderilir (bkz. docs/YAYIN.md).
# VADO_SMS_PROVIDER=log
# VADO_SMS_WEBHOOK_URL=
# VADO_SMS_WEBHOOK_SECRET=

# --- Ödeme --------------------------------------------------------------------
# sandbox: deneme ödemesi, gerçek para hareketi olmaz.
# provider: lisanslı ödeme kuruluşu bağlanana kadar ödeme oturumu açılmaz (bkz. docs/TURKIYE_UYUM.md).
# VADO_PAYMENT_MODE=sandbox

# --- Depolama -----------------------------------------------------------------
# Yüklenen fotoğrafların yazıldığı klasör.
# VADO_STORAGE_DIR=storage

# --- Mini uygulama paketleri --------------------------------------------------
# Paket dosyalarının durduğu içerik adresli depo. Medya klasöründen ayrı tutulur ve doğrudan
# sunulmaz; veritabanıyla birlikte yedeklenmelidir.
# VADO_PACKAGE_DIR=package-store
# Yüklenebilecek paket arşivinin en büyük boyutu, MB (1-50). Açılmış boyut bunun dört katını
# aşamaz. Kesin değer, gerçek cihazlarda açılış süresi ölçüldükten sonra belirlenecektir.
# VADO_PACKAGE_MAX_MB=5
# Her uygulama kaydını kendi alt alan adından sunmak için şablon; {app} kaydın kimliğidir.
# Boşsa kayıtlar API'nin adresinde, /apps/<kayıt>/ yolunun altından sunulur.
# VADO_APPS_ORIGIN=https://{app}.mini.ornek.com
# Geliştiricinin kendi sunucusundan açılan kayıtlara ve şifresiz adreslere izin verir.
# Geliştirmede açıktır; canlı ortamda kapalıdır ve açılamaz.
# VADO_MINIAPP_DEV_MODE=true

# --- Örnek veri ---------------------------------------------------------------
# `npm run db:seed` örnek mini uygulamayı bu adresle kaydeder.
# VADO_SEED_MINIAPP_URL=http://localhost:5173
