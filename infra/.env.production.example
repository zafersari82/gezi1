# Canlı ortam değerleri. Bu dosyayı infra/.env.production adıyla kopyalayıp doldurun;
# doldurulmuş dosyayı depoya eklemeyin.
#
# Rastgele değer üretmek için:  openssl rand -hex 32

# Veritabanı şifresi.
POSTGRES_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_PLATFORM_PASSWORD=

# API'nin dışarıdan erişilen adresi (TLS ile) ve tarayıcıdan istek gönderebilecek kaynaklar.
VADO_PUBLIC_URL=https://api.ornek.com
VADO_CORS_ORIGINS=https://panel.ornek.com,https://business.ornek.com
VADO_BUSINESS_PUBLIC_URL=https://business.ornek.com

# İmza anahtarları: doğrulama kodu, QR kodu, mini uygulama kimliği ve kimlik belirteci için dört
# ayrı anahtar.
# Yeni kurulumda her biri ayrı üretilir:
#   echo "VADO_OTP_KEYS=k1:$(openssl rand -hex 32)"
#   echo "VADO_QR_KEYS=k1:$(openssl rand -hex 32)"
#   echo "VADO_OPENID_KEY=$(openssl rand -hex 32)"
#   echo "VADO_IDENTITY_KEYS=k1:$(openssl rand -hex 32)"
# 2.1 ve öncesinden yükseltiyorsanız yeniden üretmeyin: kullanıcı kimlikleri ve basılmış QR kodları
# geçersiz kalır. Geçiş ve anahtar değiştirme adımları docs/ANAHTARLAR.md belgesindedir.
VADO_OTP_KEYS=
VADO_QR_KEYS=
VADO_OPENID_KEY=
VADO_IDENTITY_KEYS=

# Yönetim panelinin API'ye erişirken kullandığı anahtar: en az 32 karakterlik rastgele değer.
VADO_ADMIN_API_KEY=

# Doğrulama kodlarını SMS firmanıza ileten aracı servisin adresi ve paylaşılan gizli değer.
VADO_SMS_WEBHOOK_URL=
VADO_SMS_WEBHOOK_SECRET=

# Anlık bildirim: "expo" ya da "log" (bildirim gönderilmez). Bkz. docs/YAYIN.md, "Anlık bildirim".
VADO_PUSH_PROVIDER=log
# Expo hesabında gelişmiş push güvenliği açıksa erişim belirteci; değilse boş kalır.
VADO_EXPO_ACCESS_TOKEN=

# Yönetim paneline her yönetici kendi hesabıyla girer (2.4). İlk sahip hesabı komut satırından
# açılır: docker compose run --rm api node dist/cli/admins.js create … (bkz. docs/YAYIN.md).

# sandbox: deneme ödemesi (gerçek para hareketi olmaz). provider: lisanslı ödeme kuruluşu
# bağlanana kadar ödeme oturumu açılmaz.
VADO_PAYMENT_MODE=sandbox

# Bir IP adresinin dakikadaki istek sınırı.
VADO_RATE_LIMIT_PER_MINUTE=600

# Yüklenebilecek mini uygulama paketinin (zip) en büyük boyutu, MB.
VADO_PACKAGE_MAX_MB=5

# İsteğe bağlı: her uygulama kaydını kendi alt alan adından sunar (joker DNS ve sertifika ister).
# Boş bırakılırsa paketler API'nin adresinde, kayda özel bir yolun altından sunulur.
# VADO_APPS_ORIGIN=https://{app}.mini.ornek.com

# Sipariş webhook alıcıları; JSON dizisi. HTTPS ve her alıcıya ayrı güçlü imza anahtarı.
VADO_ORDER_WEBHOOKS=[]
